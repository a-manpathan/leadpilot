# =======================================================
# LeadPilot - Environment Configuration Example
# =======================================================

# Database Configuration
# Local SQLite default (works immediately without any external accounts)
DATABASE_URL=sqlite:///./data/leadpilot.db

# Cloud Supabase PostgreSQL (uncomment and replace when deploying to cloud)
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Application Settings
APP_ENV=development
APP_PORT=8501

# Web Crawler & Search Tuning
MAX_CRAWL_PAGES_PER_SITE=3
HTTP_TIMEOUT_SECONDS=8
REQUEST_DELAY_SECONDS=1.0

# Optional: Local Ollama AI Model (leaves blank or default if not installed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
